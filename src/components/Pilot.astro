---
import CalendarDays from '@lucide/astro/icons/calendar-days';
import Building from '@lucide/astro/icons/building';
import Tag from '@lucide/astro/icons/tag';
import DoorOpen from '@lucide/astro/icons/door-open';
import SectionHeading from './SectionHeading.astro';
import MessengerButtons from './MessengerButtons.astro';
import { texts } from '../texts';
import { contactLinks } from '../lib/links';

const { pilot } = texts;
const icons = [CalendarDays, Building, Tag, DoorOpen];
---

<!-- The page's one orange band, like a site safety sign: graphite on safety orange. -->
<section
  id="pilot"
  aria-labelledby="pilot-title"
  class="bg-accent text-on-accent [--bf-focus:var(--bf-on-accent)]"
>
  <div class="hazard-stripes h-2" aria-hidden="true"></div>
  <div class="container-page grid grid-cols-1 gap-10 py-16 md:py-20 lg:grid-cols-2 lg:gap-16 lg:py-24">
    <div>
      <SectionHeading id="pilot-title" number="04" label={pilot.label} title={pilot.title} tone="accent" />
      <p class="mt-6 max-w-xl text-lg font-medium sm:text-xl" data-reveal>{pilot.text}</p>
    </div>

    <div class="lg:pt-10" data-reveal>
      <!-- Conditions as a spec sheet: one ruled list. -->
      <ul class="divide-y-2 divide-on-accent/20 rounded-xl border-2 border-on-accent">
        {
          pilot.conditions.map((condition, index) => {
            const Icon = icons[index];
            return (
              <li class="flex items-center gap-4 px-5 py-4">
                {Icon && <Icon class="size-6 shrink-0" />}
                <span class="text-lg leading-snug font-bold">{condition}</span>
              </li>
            );
          })
        }
      </ul>
      <MessengerButtons class="mt-8" label={pilot.cta} links={contactLinks.pilot} tone="accent" />
      <p class="mt-4 text-base font-medium">{pilot.hint}</p>
    </div>
  </div>
</section>
