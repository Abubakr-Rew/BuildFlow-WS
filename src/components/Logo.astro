---
// BuildBetter mark: a hard hat on a safety-orange tile. Decorative; pair it with visible text.
import { markShapes } from '../lib/brand';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
  set:html={markShapes('var(--bf-accent)', 'var(--bf-on-accent)')}
/>
