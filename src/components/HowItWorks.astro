---
import Smartphone from '@lucide/astro/icons/smartphone';
import Camera from '@lucide/astro/icons/camera';
import GalleryVerticalEnd from '@lucide/astro/icons/gallery-vertical-end';
import SectionHeading from './SectionHeading.astro';
import { texts } from '../texts';

const { how } = texts;
const icons = [Smartphone, Camera, GalleryVerticalEnd];
const last = how.steps.length - 1;
---

<section
  id="how"
  aria-labelledby="how-title"
  class="relative isolate overflow-hidden border-y border-line bg-sunken py-16 md:py-24"
>
  <div class="bg-blueprint mask-fade-edges absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page">
    <SectionHeading id="how-title" number="02" label={how.label} title={how.title} lead={how.lead} />

    <!-- Large orange step numbers on one line: vertical on phones, horizontal from 768px. -->
    <ol class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      {
        how.steps.map((step, index) => {
          const Icon = icons[index];
          return (
            <li
              class="relative grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-4 md:flex md:flex-col"
              data-reveal
              style={`--reveal-delay: ${index * 100}ms`}
            >
              {index < last && (
                <span
                  class="absolute top-[4.5rem] -bottom-6 left-9 w-1 -translate-x-1/2 bg-accent md:top-9 md:right-[-2rem] md:bottom-auto md:left-[4.5rem] md:h-1 md:w-auto md:translate-x-0 md:-translate-y-1/2"
                  aria-hidden="true"
                />
              )}
              <span
                class="relative grid size-[4.5rem] place-items-center rounded-full bg-accent font-display text-4xl font-extrabold text-on-accent tabular-nums ring-8 ring-sunken"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <div class="rounded-xl border border-line bg-surface p-5 md:mt-6 md:flex-1 md:p-6">
                <div class="flex items-center justify-between gap-3">
                  <span class="inline-block rounded-md bg-sunken px-2.5 py-0.5 text-sm font-semibold text-muted">
                    {step.role}
                  </span>
                  {Icon && <Icon class="size-7 shrink-0 text-muted" stroke-width={1.75} />}
                </div>
                <p class="mt-3 text-lg leading-snug font-semibold">{step.text}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
