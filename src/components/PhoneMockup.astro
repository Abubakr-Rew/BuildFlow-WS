---
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import Camera from '@lucide/astro/icons/camera';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Plus from '@lucide/astro/icons/plus';
import Signal from '@lucide/astro/icons/signal';
import BatteryMedium from '@lucide/astro/icons/battery-medium';
import SitePhoto from './SitePhoto.astro';
import { texts } from '../texts';

const { mockup } = texts;
const scenes = ['frame', 'brick'] as const;
const floatingCard =
  'animate-float absolute z-10 rounded-xl border border-line-strong bg-surface p-3 text-fg shadow-[0_16px_32px_-12px_rgb(0_0_0/0.55)]';
---

<!-- The phone, the floating cards and the glow are one sample illustration, described by the caption. -->
<figure class="relative mx-auto w-full max-w-[19rem]" data-mockup>
  <!-- text-fg: the app screen follows the page theme, unlike the always-dark hero around it. -->
  <div class="relative text-fg" aria-hidden="true">
    <!-- Glow anchored to the fixed-height phone, so font loading in the caption cannot move it. -->
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 -z-10 size-[36rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--bf-accent)_45%,transparent),transparent)]"
    >
    </div>

    <div
      class="relative rounded-[2.75rem] bg-inverse p-2.5 shadow-[0_32px_64px_-16px_rgb(0_0_0/0.6)] ring-1 ring-line-strong"
    >
      <div class="relative h-[34rem] overflow-hidden rounded-[2.2rem] bg-bg">
        <div class="flex h-9 items-center justify-between px-6 pt-1 text-xs font-semibold">
          <span class="tabular-nums">{mockup.clock}</span>
          <span class="absolute top-2.5 left-1/2 size-3.5 -translate-x-1/2 rounded-full bg-inverse"></span>
          <span class="flex items-center gap-1">
            <Signal class="size-3.5" />
            <BatteryMedium class="size-4" />
          </span>
        </div>

        <div class="flex items-center gap-2 border-b border-line bg-surface px-3 py-2.5">
          <ChevronLeft class="size-5 shrink-0 text-muted" />
          <div class="min-w-0">
            <p class="truncate font-display text-sm leading-tight font-extrabold">{mockup.screenTitle}</p>
            <p class="text-xs leading-tight text-muted">{mockup.screenSubtitle}</p>
          </div>
        </div>

        <div class="space-y-3 px-3 pt-3">
          <p class="text-center">
            <span class="inline-block rounded-full bg-sunken px-3 py-0.5 text-xs font-semibold text-muted">
              {mockup.today}
            </span>
          </p>
          {
            mockup.reports.map((report, index) => (
              <article class="rounded-2xl border border-line bg-surface p-3">
                <div class="flex items-center gap-2">
                  <span class="grid size-7 place-items-center rounded-full bg-accent font-display text-xs font-extrabold text-on-accent">
                    {report.author.charAt(0)}
                  </span>
                  <span class="text-[0.8125rem] font-bold">{report.author}</span>
                  <span class="ml-auto text-xs text-muted tabular-nums">{report.time}</span>
                </div>
                <SitePhoto scene={scenes[index % scenes.length]} class="mt-2.5 block w-full rounded-xl" />
                <p class="mt-2 text-[0.8125rem] leading-snug">{report.text}</p>
                <p class="mt-1.5 flex items-center gap-1 text-xs text-muted">
                  <Camera class="size-3.5" />
                  {report.photos}
                </p>
              </article>
            ))
          }
        </div>

        <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-bg from-55% to-transparent px-3 pt-10 pb-4">
          <p class="flex h-12 items-center justify-center gap-2 rounded-xl bg-accent font-display text-sm font-extrabold text-on-accent">
            <Plus class="size-5" stroke-width={3} />
            {mockup.newReport}
          </p>
        </div>
      </div>
    </div>

    <div class:list={[floatingCard, '-top-3 -left-3 w-56 -rotate-3 sm:-left-20 lg:-left-10 xl:-left-20']}>
      <div class="flex items-start gap-2.5">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent text-on-accent">
          <Camera class="size-4" />
        </span>
        <div class="min-w-0">
          <p class="text-[0.8125rem] leading-tight font-bold">{mockup.toastTitle}</p>
          <p class="mt-0.5 text-xs leading-snug text-muted">{mockup.toastMeta}</p>
        </div>
      </div>
    </div>

    <div class:list={[floatingCard, '-right-3 bottom-28 w-48 rotate-2 [animation-delay:4.5s] sm:-right-16 lg:-right-4 xl:-right-16']}>
      <p class="flex items-center gap-2 text-[0.8125rem] font-bold">
        <CircleCheck class="size-4 shrink-0 text-accent-ink" />
        {mockup.upload}
      </p>
      <span class="mt-2 block h-1.5 rounded-full bg-accent"></span>
    </div>
  </div>

  <figcaption class="mt-6 text-center">
    <span class="label-caps flex items-center justify-center gap-3 text-accent">
      <span class="h-0.5 w-6 bg-current" aria-hidden="true"></span>
      {mockup.caption}
      <span class="h-0.5 w-6 bg-current" aria-hidden="true"></span>
    </span>
    <span class="mt-1 block text-sm text-on-night-muted">{mockup.captionNote}</span>
    <span class="sr-only">{mockup.description}</span>
  </figcaption>
</figure>
