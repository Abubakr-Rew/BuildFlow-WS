---
// Flat illustration standing in for a site photo inside the phone mockup.
// "frame": concrete frame with a tower crane; "rebar": delivered rebar by the foundation.
interface Props {
  scene: 'frame' | 'rebar';
  class?: string;
}

const { scene, class: className } = Astro.props;
---

<svg class:list={['site-photo', className]} viewBox="0 0 320 180" aria-hidden="true" focusable="false">
  <rect width="320" height="180" fill="var(--sky)"></rect>
  <path d="M0 150V112h26V96h22v20h20V84h24v66zM236 150V104h18V90h28v22h38v38z" fill="var(--far)"></path>
  <rect y="148" width="320" height="32" fill="var(--ground)"></rect>
  {
    scene === 'frame' ? (
      <g>
        <g fill="var(--concrete)">
          <rect x="52" y="140" width="164" height="8" />
          <rect x="52" y="104" width="164" height="8" />
          <rect x="56" y="112" width="8" height="28" />
          <rect x="104" y="112" width="8" height="28" />
          <rect x="152" y="112" width="8" height="28" />
          <rect x="204" y="112" width="8" height="28" />
        </g>
        <rect x="52" y="68" width="164" height="8" fill="var(--concrete-fresh)" />
        <g stroke="var(--concrete-dark)" stroke-width="3">
          <path d="M60 76v28M84 76v28M108 76v28M132 76v28M156 76v28M180 76v28M208 76v28" />
        </g>
        <g stroke="var(--crane)" stroke-width="3" fill="none" stroke-linejoin="round">
          <path d="M258 148V34M270 148V34" />
          <path d="M258 148l12-14-12-14 12-14-12-14 12-14-12-14 12-14-12-8" />
          <path d="M180 34h120M180 26h104M244 26l14-12h12l14 12" />
          <path d="M188 34l8-8 8 8 8-8 8 8 8-8 8 8 8-8 8 8" />
        </g>
        <rect x="282" y="34" width="18" height="14" fill="var(--concrete-dark)" />
        <path d="M200 34v26" stroke="var(--cable)" stroke-width="1.5" />
        <rect x="188" y="60" width="24" height="8" rx="1" fill="var(--rebar)" />
      </g>
    ) : (
      <g>
        <rect x="40" y="132" width="200" height="16" fill="var(--concrete)" />
        <g stroke="var(--rebar)" stroke-width="3" stroke-linecap="round">
          <path d="M44 132V92M76 132V92M108 132V92M140 132V92M172 132V92M204 132V92M236 132V92" />
        </g>
        <g stroke="var(--concrete-dark)" stroke-width="2">
          <path d="M44 102h192M44 116h192" />
        </g>
        <rect x="150" y="160" width="132" height="8" fill="var(--pallet)" />
        <g stroke="var(--rebar)" stroke-width="3" stroke-linecap="round">
          <path d="M146 154h140M150 148h132M154 142h124" />
        </g>
        <path d="M18 168l26-30 30 30z" fill="var(--gravel)" />
      </g>
    )
  }
</svg>

<style>
  .site-photo {
    --sky: #d9e1e6;
    --far: #c3ccd3;
    --ground: #c9c0ae;
    --concrete: #9aa0a6;
    --concrete-fresh: #b7bcc1;
    --concrete-dark: #6f757b;
    --rebar: #8a4b2a;
    --pallet: #b08a5a;
    --gravel: #a8a194;
    --crane: var(--bf-accent);
    --cable: #4b4e54;
  }

  @media (prefers-color-scheme: dark) {
    .site-photo {
      --sky: #27303a;
      --far: #313c47;
      --ground: #3a3730;
      --concrete: #6c7279;
      --concrete-fresh: #858b92;
      --concrete-dark: #4f555c;
      --rebar: #b8693c;
      --pallet: #7d6343;
      --gravel: #5d5850;
      --cable: #a9acb2;
    }
  }
</style>
