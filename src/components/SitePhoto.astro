---
// Flat illustration standing in for a site photo inside the phone mockup.
// "frame": concrete frame with a tower crane; "brick": a brick wall going up, racked back at the top.
interface Props {
  scene: 'frame' | 'brick';
  class?: string;
}

const { scene, class: className } = Astro.props;

// Brick courses, bottom to top: 40x18 module with 3px mortar joints, every other course offset.
const COURSE = 18;
const MODULE = 40;
const JOINT = 3;
const courseEnds = [320, 320, 320, 320, 300, 260, 220];
const courses = courseEnds.map((end, index) => {
  const y = 150 - (index + 1) * COURSE;
  const start = index % 2 ? -MODULE / 2 : 0;
  const bricks = [];
  for (let x = start; x < end; x += MODULE) {
    bricks.push({ x: x + JOINT / 2, width: Math.min(MODULE, end - x) - JOINT });
  }
  return { y, end, bricks };
});
---

<svg class:list={['site-photo', className]} viewBox="0 0 320 180" aria-hidden="true" focusable="false">
  <rect width="320" height="180" fill="var(--sky)"></rect>
  <path d="M0 150V112h26V96h22v20h20V84h24v66zM236 150V104h18V90h28v22h38v38z" fill="var(--far)"></path>
  <rect y="148" width="320" height="32" fill="var(--ground)"></rect>
  {
    scene === 'frame' ? (
      <g>
        <g fill="var(--concrete)">
          <rect x="52" y="140" width="164" height="8" />
          <rect x="52" y="104" width="164" height="8" />
          <rect x="56" y="112" width="8" height="28" />
          <rect x="104" y="112" width="8" height="28" />
          <rect x="152" y="112" width="8" height="28" />
          <rect x="204" y="112" width="8" height="28" />
        </g>
        <rect x="52" y="68" width="164" height="8" fill="var(--concrete-fresh)" />
        <g stroke="var(--concrete-dark)" stroke-width="3">
          <path d="M60 76v28M84 76v28M108 76v28M132 76v28M156 76v28M180 76v28M208 76v28" />
        </g>
        <g stroke="var(--crane)" stroke-width="3" fill="none" stroke-linejoin="round">
          <path d="M258 148V34M270 148V34" />
          <path d="M258 148l12-14-12-14 12-14-12-14 12-14-12-14 12-14-12-8" />
          <path d="M180 34h120M180 26h104M244 26l14-12h12l14 12" />
          <path d="M188 34l8-8 8 8 8-8 8 8 8-8 8 8 8-8 8 8" />
        </g>
        <rect x="282" y="34" width="18" height="14" fill="var(--concrete-dark)" />
        <path d="M200 34v26" stroke="var(--cable)" stroke-width="1.5" />
        <rect x="188" y="60" width="24" height="8" rx="1" fill="var(--rebar)" />
      </g>
    ) : (
      <g>
        {courses.map((course) => (
          <g>
            <rect x="0" y={course.y} width={course.end} height={COURSE} fill="var(--mortar)" />
            {course.bricks.map((brick) => (
              <rect
                x={brick.x}
                y={course.y + JOINT / 2}
                width={brick.width}
                height={COURSE - JOINT}
                rx="1"
                fill="var(--brick)"
              />
            ))}
          </g>
        ))}
        <rect x="116" y="17" width="88" height="7" rx="2" fill="var(--crane)" />
        <rect x="154" y="18.5" width="12" height="4" rx="2" fill="var(--sky)" />
        <rect y="150" width="320" height="8" fill="var(--plank)" />
        <path d="M252 150l4-22h32l4 22z" fill="var(--concrete-dark)" />
        <rect x="250" y="124" width="44" height="6" rx="2" fill="var(--concrete)" />
      </g>
    )
  }
</svg>

<style>
  .site-photo {
    --sky: #d9e1e6;
    --far: #c3ccd3;
    --ground: #c9c0ae;
    --concrete: #9aa0a6;
    --concrete-fresh: #b7bcc1;
    --concrete-dark: #6f757b;
    --rebar: #8a4b2a;
    --brick: #a5603f;
    --mortar: #cfc8bb;
    --plank: #b08a5a;
    --crane: var(--bf-accent);
    --cable: #4b4e54;
  }

  @media (prefers-color-scheme: dark) {
    .site-photo {
      --sky: #27303a;
      --far: #313c47;
      --ground: #3a3730;
      --concrete: #6c7279;
      --concrete-fresh: #858b92;
      --concrete-dark: #4f555c;
      --rebar: #b8693c;
      --brick: #7e4a35;
      --mortar: #4d4a44;
      --plank: #7d6343;
      --cable: #a9acb2;
    }
  }
</style>
