---
import Send from '@lucide/astro/icons/send';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Mail from '@lucide/astro/icons/mail';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionHeading from './SectionHeading.astro';
import { texts } from '../texts';
import { siteConfig } from '../site.config';
import { contactLinks, formatPhone } from '../lib/links';

const { contact } = texts;

// Messenger links carry the pilot message: the hero's "try for free" button leads here.
const channels = [
  {
    icon: Send,
    name: contact.telegram,
    value: `@${siteConfig.telegramUsername.replace(/^@/, '')}`,
    href: contactLinks.pilot.telegram,
    external: true,
  },
  {
    icon: MessageCircle,
    name: contact.whatsapp,
    value: formatPhone(siteConfig.whatsappNumber),
    href: contactLinks.pilot.whatsapp,
    external: true,
  },
  {
    icon: Mail,
    name: contact.email,
    value: siteConfig.email,
    href: contactLinks.email,
    external: false,
  },
];
---

<section id="contact" aria-labelledby="contact-title" class="border-y border-line bg-sunken py-16 md:py-24">
  <div class="container-page">
    <SectionHeading
      id="contact-title"
      number="06"
      label={contact.label}
      title={contact.title}
      lead={contact.text}
    />

    <ul class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        channels.map((channel, index) => {
          const Icon = channel.icon;
          return (
            <li data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <a
                href={channel.href}
                class="group flex min-h-24 items-center gap-4 rounded-xl border-2 border-line bg-surface p-5 transition-colors duration-200 hover:border-accent"
                {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="grid size-12 shrink-0 place-items-center rounded-lg bg-accent text-on-accent">
                  <Icon class="size-6" />
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="text-base text-muted">{channel.name}</span>
                  <span class="font-display text-lg font-extrabold break-words">{channel.value}</span>
                </span>
                <ArrowUpRight class="ml-auto size-5 shrink-0 text-muted transition-colors duration-200 group-hover:text-accent-ink" />
                {channel.external && <span class="sr-only">{texts.common.newTab}</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
